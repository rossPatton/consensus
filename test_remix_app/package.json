{
  "name": "test-remix-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "seed": "npx tsx ./prisma/seed/seed.ts",
    "migrate": "prisma migrate deploy",
    "postmigrate": "npx @snaplet/seed sync",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:seed": "prisma db seed",
    "db:seed_init": "npx @snaplet/seed init prisma/seed",
    "db:seed_sync": "npx @snaplet/seed sync",
    "db:migration_apply": "npx prisma migrate dev",
    "db:migration_deploy": "prisma migrate deploy",
    "db:migration_new": "prisma migrate dev --create-only",
    "db:migration_resolve": "prisma migrate resolve --applied",
    "db:migration_status": "prisma migrate status"
  },
  "dependencies": {
    "@epic-web/client-hints": "^1.3.5",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "~5.21.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@remix-run/node": "~2.13.1",
    "@remix-run/react": "~2.13.1",
    "@remix-run/serve": "~2.13.1",
    "@tanstack/react-query": "~5.59.15",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "html-react-parser": "^5.1.18",
    "isbot": "~4.1.0",
    "lodash-es": "~4.17.21",
    "loglevel": "~1.9.2",
    "lucide-react": "^0.456.0",
    "pluralize": "^8.0.0",
    "qs": "^6.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.53.2",
    "remix-themes": "^1.5.1",
    "tailwind-merge": "^2.5.4",
    "tsx": "~4.19.1",
    "uuid": "~10.0.0",
    "zod": "~3.23.8",
    "zod-prisma-types": "~3.1.8"
  },
  "devDependencies": {
    "@anatine/zod-mock": "3.9.0",
    "@remix-run/dev": "~2.13.1",
    "@snaplet/copycat": "~5.1.0",
    "@snaplet/seed": "~0.98.0",
    "@tailwindcss/typography": "~0.5.15",
    "@types/lodash-es": "^4.17.12",
    "@types/pluralize": "^0.0.33",
    "@types/qs": "^6.9.16",
    "@types/react": "~18.2.20",
    "@types/react-dom": "~18.2.7",
    "@typescript-eslint/eslint-plugin": "~6.7.4",
    "@typescript-eslint/parser": "~6.7.4",
    "autoprefixer": "~10.4.19",
    "eslint": "~8.38.0",
    "eslint-import-resolver-typescript": "~3.6.1",
    "eslint-plugin-import": "~2.28.1",
    "eslint-plugin-jsx-a11y": "~6.7.1",
    "eslint-plugin-react": "~7.33.2",
    "eslint-plugin-react-hooks": "~4.6.0",
    "postcss": "~8.4.38",
    "prisma": "~5.21.1",
    "remix-flat-routes": "^0.6.5",
    "tailwind-scrollbar": "~3.1.0",
    "tailwindcss": "~3.4.4",
    "tailwindcss-animate": "~1.0.7",
    "typescript": "~5.1.6",
    "vite": "~5.1.0",
    "vite-tsconfig-paths": "~4.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "@snaplet/seed": {
    "config": "prisma/seed/seed.config.ts"
  }
}
